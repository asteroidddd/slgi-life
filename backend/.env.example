# SLGI backend .env 템플릿
#
# 사용법:
#   1) 본 파일을 .env로 복사 후 값을 채운다.
#   2) 모든 secret/key 값은 placeholder. 직접 채워야 동작한다.
#
# 보안:
#   - 본 .env.example 파일은 git 추적 가능 (placeholder만 포함).
#   - 실제 .env 파일은 git ignore. 평문 secret 절대 커밋 금지.

# ─── Django core ─────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=

# ─── Database (SLGI 자체 PostGIS 컨테이너) ─────────────────────
DATABASE_URL=

# ─── AI Agent (LLM 생성 SQL은 read-only 계정으로만 실행) ───────
AI_AGENT_OPENAI_API_KEY=
AI_AGENT_OPENAI_BASE_URL=
AI_AGENT_DATABASE_URL=

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=

# ─── CORS ────────────────────────────────────────────────────
DJANGO_CORS_ALLOWED_ORIGINS=

# ─── 외부 API ────────────
PUBLIC_DATA_API_KEY=
SEOUL_API_KEY=
V_WORLD_API_KEY=
KOSIS_API_KEY=
LIFE_INFO_API_KEY=

# ─── Kakao 로그인 ────────────────────────────────────────────
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=
FRONTEND_URL=
