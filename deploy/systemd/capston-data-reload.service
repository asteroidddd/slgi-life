[Unit]
Description=Capston full managed-data reset and reload
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/capston
ExecStartPre=/usr/bin/docker compose -f /home/ubuntu/capston/docker-compose.yml up -d db redis
ExecStart=/usr/bin/docker compose -f /home/ubuntu/capston/docker-compose.yml run --rm backend python scripts/update/update_all.py --write --max-hours 23 --reset-managed-data
TimeoutStartSec=24h
KillSignal=SIGTERM
KillMode=control-group
StandardOutput=journal
StandardError=journal

